# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-key
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001

# Google Calendar
GOOGLE_CLIENT_ID=your-google-client-id

# GoCardless (bank sync)
GC_SECRET_ID=your-gc-secret-id
GC_SECRET_KEY=your-gc-secret-key

# Salt Edge (bank sync)
SE_APP_ID=your-se-app-id
SE_SECRET=your-se-secret

# Vercel Cron auth
CRON_SECRET=your-cron-secret

# Samsung Health sleep ingest
SLEEP_INGEST_SECRET=your-sleep-ingest-secret
