<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#0A0A0B">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Health Bridge"
        android:textSize="28sp"
        android:textColor="#E8E6E0"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Serves Samsung Health data\nto your dashboard on port 8765"
        android:textSize="14sp"
        android:textColor="#76746E"
        android:gravity="center"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/connectBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connect Health Data"
        android:paddingHorizontal="32dp"
        android:paddingVertical="14dp"
        android:textSize="16sp"
        android:backgroundTint="#34D399"
        android:textColor="#0A0A0B"
        android:layout_marginBottom="32dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap Connect to grant permissions and start the server"
        android:textSize="14sp"
        android:textColor="#A8A6A0"
        android:gravity="center"
        android:lineSpacingExtra="4dp" />

</LinearLayout>
