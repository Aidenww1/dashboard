                          "description":  "Open body logging"
                      },
                      {
                          "name":  "Ask Coach",
                          "short_name":  "Coach",
                          "url":  "/ui/coach.html#ask",
                          "description":  "Ask about your Life OS data"
                      },
                      {
                          "name":  "Open Money",
                          "short_name":  "Money",
