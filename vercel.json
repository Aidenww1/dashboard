{
  "version": 2,
  "crons": [
    {
      "path": "/api/health-ai/agent",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/health-ai/agent?briefing=evening",
      "schedule": "0 19 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/health", "destination": "/api/events/add" }
  ]
}
